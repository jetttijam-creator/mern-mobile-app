{
  "expo": {
    "name": "Shopfront",
    "slug": "mern-mobile-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phoenixone.shopfront.jett",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon.png",
        "backgroundColor": "#1e6fd9"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.phoenixone.shopfront.jett",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shopfront reads your photo library so you can choose a profile photo.",
          "cameraPermission": "Shopfront uses the camera to take your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Shopfront uses the camera to take your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shopfront uses your location to show where you are and to tag where you shop."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1e6fd9"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "b6ab4c81-acc4-4aa1-8e30-e2e02397e177"
      }
    },
    "owner": "jettzkie",
    "updates": {
      "url": "https://u.expo.dev/b6ab4c81-acc4-4aa1-8e30-e2e02397e177"
    }
  }
}
